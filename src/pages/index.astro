---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
---

<BaseLayout>
  <main id="main-content">
    <Hero />

    <section class="section shell work" id="work" aria-labelledby="work-title">
      <header class="section-heading">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 id="work-title">A few things worth opening.</h2>
        </div>
        <p>Small set. Deep work.</p>
      </header>

      <div class="project-list">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="section shell about" id="about" aria-labelledby="about-title">
      <p class="eyebrow">Approach</p>
      <h2 id="about-title">
        Technical depth should become something people can <em>feel</em>, not something they must endure.
      </h2>
      <div class="about__grid">
        <p>
          I care about systems that stay understandable under pressure: deterministic simulations, sharp interfaces, careful graphics, and verification that makes ambitious work dependable.
        </p>
        <p>
          This site follows the same rule. The content arrives first; native browser features add polish; the GPU is invited only after the page is already useful.
        </p>
      </div>
    </section>

    <section class="section shell contact" aria-labelledby="contact-title">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Have an interesting system to build?</h2>
      <a class="contact__link" href={site.github} rel="noopener">
        <span>github.com/lotgood</span><span aria-hidden="true">↗</span>
      </a>
    </section>

    <SiteFooter />
  </main>
</BaseLayout>
