---
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  mode?: 'overlay' | 'solid';
}

const { mode = 'solid' } = Astro.props;
---

<header class:list={['site-header', `site-header--${mode}`]}>
  <div class="shell site-header__inner">
    <a class="brand" href={withBase('/')} aria-label={`${site.name}, home`}>
      <span>{site.shortName}</span><span class="brand__dot" aria-hidden="true">.</span>
    </a>

    <nav aria-label="Primary navigation">
      <a href={withBase('/#work')}>Work</a>
      <a href={withBase('/#about')}>About</a>
      <a href={site.github} rel="noopener">Contact</a>
    </nav>
  </div>
</header>
